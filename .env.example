# Template only. Set production credentials in your hosting provider's environment settings.
DATABASE_URL="mysql://<db-user>:<url-encoded-password>@<mysql-host>:3306/<db-name>"

# Super Admin initialization
SUPER_ADMIN_LOGIN="replace-with-a-private-admin-login"
SUPER_ADMIN_PASSWORD="replace-with-a-unique-secret"

# Local development; set production in the hosting environment.
NODE_ENV="development"
